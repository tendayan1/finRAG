# ===== rag_v2 配置 =====
# 任意 OpenAI 兼容端点均可：DeepSeek / Qwen(DashScope 兼容模式) / vLLM / Ollama 等
# DeepSeek 示例:  https://api.deepseek.com/v1
# Qwen 示例:      https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 示例:    http://localhost:11434/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx

# 对话模型
CHAT_MODEL=deepseek-chat

# Embedding 模型（注意：DeepSeek 无 embedding 接口，需换支持 /embeddings 的端点，
# 例如 DashScope 兼容模式的 text-embedding-v4）
EMBEDDING_MODEL=text-embedding-v4

# 路径（一般无需修改）
# VECTORSTORE_DIR=./vectorstore
# DOCS_DIR=./data/sample_docs

# 注意：向量库与 embedding 模型绑定，更换 EMBEDDING_MODEL 后必须
# 重新执行 python -m rag_v2.ingest --reset 建库。

# 可选：LangSmith 追踪
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2-xxx
